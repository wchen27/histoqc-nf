process {
    container     = 'wchen27/histoqc-cpu:2.0-f35e518'
    cpus          = 1
    memory        = { 8.GB * task.attempt }
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
    maxRetries    = 1

    withName: HISTOQC_SUMMARY {
        memory        = 8.GB
        errorStrategy = 'terminate'
    }
}

docker.enabled = true
